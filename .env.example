DATABASE_URL=postgres://filestorage:filestorage@localhost:5434/file_storage_connector
PUBLIC_BASE_URL=http://localhost:3081
BETTER_AUTH_SECRET=change-me-to-a-long-random-secret

# "Login with Agentblit" (OIDC). Issuer is the console; no URLs are hardcoded.
AGENTBLIT_APP_URL=http://localhost:3000
AGENTBLIT_CLIENT_ID=file-storage-connector
# Printed once by `pnpm oauth:seed` in the console repo.
AGENTBLIT_CLIENT_SECRET=

# AWS S3 (required for save/retrieve)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=
# Optional — set for MinIO / custom S3-compatible endpoints
# AWS_S3_ENDPOINT=http://localhost:9000
# AWS_S3_FORCE_PATH_STYLE=true
